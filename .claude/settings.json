{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
		"defaultMode": "acceptEdits",
		"allow": [
			"Bash(npm install)",
			"Bash(npm ci)",
			"Bash(npm run *)",
			"Bash(cd client && npm run *)",
			"Bash(npm test *)",
			"Bash(npm test)",
			"Bash(npx tsc *)",
			"Bash(npx tsx *)",
			"Bash(npx eslint *)",
			"Bash(npx oxlint *)",
			"Bash(npx vite *)",
			"Bash(npx prettier *)",
			"Bash(npx vitest *)",
			"Bash(npx jest *)",
			"Bash(node --version)",
			"Bash(git diff *)",
			"Bash(git status)",
			"Bash(git log *)",
			"Bash(git add *)",
			"Bash(git commit *)",
			"Bash(git stash *)",
			"Bash(git branch *)",
			"Bash(git checkout *)",
			"Bash(make verify*)",
			"Bash(make test)",
			"Bash(make build)",
			"Bash(make clean)",
			"Read",
			"Glob",
			"Grep"
		],
		"deny": [
			"Bash(git push --force *)",
			"Bash(git push -f *)",
			"Bash(git reset --hard *)",
			"Bash(rm -rf *)",
			"Bash(sudo *)",
			"Bash(chmod 777 *)",
			"Bash(curl * | sh)",
			"Bash(curl * | bash)",
			"Bash(wget * | sh)",
			"Bash(wget * | bash)",
			"Bash(wget * -O- *)",
			"Read(.env)",
			"Read(.env.*)",
			"Read(**/.env)",
			"Read(**/.env.*)",
			"Read(**/credentials*)",
			"Read(**/*.pem)",
			"Read(**/*.key)",
			"Read(**/*secret*)",
			"Read(**/*.sops.*)",
			"Read(**/*.tfstate)",
			"Read(**/*.tfstate.backup)",
			"Read(~/.ssh/**)",
			"Read(~/.aws/**)",
			"Read(~/.kube/config)",
			"Edit(.env)",
			"Edit(.env.*)",
			"Edit(**/.env)",
			"Edit(**/.env.*)"
		]
	},

  "project": {
    "testCommand": "npm test",
    "lintCommand": "npm run lint",
    "typecheckCommand": "npm run typecheck"
  },

  "env": {
    "NODE_ENV": "test",
    "TZ": "UTC",
    "FORCE_COLOR": "1",
    "CI": "true"
  }
}
